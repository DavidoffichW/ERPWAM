{
  "name": "erpwam",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Explore asset performance, resource utilization, forecasts, and scenarios in your browser.",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "oxlint src tests vite.config.ts vitest.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build",
    "preview": "vite preview",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
